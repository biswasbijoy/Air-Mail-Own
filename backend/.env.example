# Server
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/airmail

# Use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret

# Comma-free origin or * for development
CORS_ORIGIN=*

# Token lifetime accepted by jsonwebtoken (for example 7d)
JWT_EXPIRES_IN=7d

# How long an unanswered call rings before timing out, in milliseconds
CALL_RING_TIMEOUT_MS=45000

# Optional TURN server configuration for cross-network WebRTC audio calls
# Option A: Metered.ca (Free 20 GB/month) - https://www.metered.ca/tools/openrelay/
# METERED_DOMAIN=your-app-domain
# METERED_API_KEY=your-api-key

# Option B: Direct TURN credentials (Coturn / Twilio / custom TURN)
# TURN_URL=turn:your-turn-host:3478,turn:your-turn-host:443?transport=tcp
# TURN_USERNAME=username
# TURN_CREDENTIAL=credential
