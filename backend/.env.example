# Server
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/airmail

# Use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret

# Comma-free origin or * for development
CORS_ORIGIN=*

# Token lifetime accepted by jsonwebtoken (for example 7d)
JWT_EXPIRES_IN=7d
